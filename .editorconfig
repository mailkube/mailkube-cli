root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 120

[*.{yml,yaml,json,toml,md,js,jsx,ts,tsx,cjs,mjs}]
indent_size = 2

# Two, matching every script already in scripts/. shfmt reads this file, so without the rule it
# would reformat all of them to four and the shell gate would fail on files nobody had touched.
[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
