# Binaries & test artifacts
*.exe
*.test
*.out

# Golden files are the committed record of every screen, and half of each screen is stdout.
# Without this the *.out rule above quietly excludes the payload stream — the one the stream
# contract exists to protect — leaving the suite reviewable only in its stderr half.
!**/testdata/golden/*.out

# Build output
/dist/
/bin/

# Coverage
coverage.out
coverage.txt

# Go workspace
go.work
go.work.sum

# Tooling caches
.jscpd/

# Secrets / local config
.env

# Local SDK co-development; never committed (see .rules/ARCHITECTURE.md).
go.work
go.work.sum

# Build output
/dist/
/mailkube
