# Binaries & test artifacts
*.exe
*.test
*.out

# Golden files are the committed record of every screen, and half of each screen is stdout.
# Without this the *.out rule above quietly excludes the payload stream — the one the stream
# contract exists to protect — leaving the suite reviewable only in its stderr half.
!**/testdata/golden/*.out

# Build and release output
/dist/
/bin/
/mailkube

# Generated by scripts/gen-completions.sh for the release archives and packages. Never committed:
# a generated file in the tree marks the checkout dirty, and the toolchain reads the version out
# of the VCS state, so a dirty tree ships a binary reporting a version the release does not have.
/completions/

# Coverage
coverage.out
coverage.txt

# Local SDK co-development; never committed (see .rules/ARCHITECTURE.md).
go.work
go.work.sum

# Tooling caches
.jscpd/

# Secrets / local config
.env
